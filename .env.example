# Choose: demo | openai_compatible | ollama
LLM_PROVIDER=demo

# For OpenAI-compatible providers (OpenAI, IBM-compatible gateways, etc.)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# For Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

EMBEDDING_MODE=tfidf
TOP_K=5
